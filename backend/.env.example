# Copy to .env.local for Code Arena development. Keep secrets out of Git.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://codearena@127.0.0.1:55432/codearena?schema=public
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# Generate a different random 32-byte hexadecimal string for each secret.
JWT_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEY=
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# Single API process only. Production should use Redis/BullMQ instead.
JUDGE_QUEUE_DRIVER=postgres-local
REDIS_URL=redis://127.0.0.1:56379
QUEUE_REDIS_URL=
LIVE_EVENTS_ENABLED=true
DISABLE_BATTLE_WORKERS=false
TRUSTED_PROXY_CIDRS=
